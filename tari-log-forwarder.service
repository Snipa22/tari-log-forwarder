[Unit]
Description=Tari base_node log forwarder (all base_node log files to systemd journal)
Documentation=https://github.com/Snipa22/tari-log-forwarder
After=network.target tari.service

[Service]
Type=simple
User=tari
Group=tari
Environment=TARI_LOG_DIR=/home/tari/.tari/mainnet/log/base_node
ExecStart=/usr/local/bin/tari-log-forwarder.sh
Restart=always
RestartSec=2

# tari-log-forwarder.sh traps SIGTERM/SIGINT itself and explicitly kills
# every backgrounded tail/logger pipeline it spawned (see script comments),
# so shutdown is clean even outside systemd. Default KillMode=control-group
# also applies here as a second line of defense: on stop/restart, systemd
# signals every process left in the unit's cgroup, so nothing from any of
# the five tail -F / logger pipelines is ever left running behind a
# stopped/restarted service.

[Install]
WantedBy=multi-user.target
