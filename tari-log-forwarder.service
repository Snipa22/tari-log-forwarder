[Unit]
Description=Tari base_node base_layer.log to systemd journal forwarder
Documentation=https://github.com/Snipa22/tari-log-forwarder
After=network.target tari.service

[Service]
Type=simple
User=tari
Group=tari
Environment=TARI_LOG_PATH=/home/tari/.tari/mainnet/log/base_node/base_layer.log
ExecStart=/usr/local/bin/tari-log-forwarder.sh
Restart=always
RestartSec=2

# Default KillMode=control-group applies here: on stop/restart, systemd
# signals every process in the unit's cgroup (the script, the `tail -F`
# child, and any in-flight `logger` child), so no tail process is ever
# left running behind a stopped/restarted service.

[Install]
WantedBy=multi-user.target
